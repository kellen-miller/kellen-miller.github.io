---
import { getBlogPosts } from '../../data/blog';
import WritingLog from '../../components/WritingLog.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = await getBlogPosts();
---

<BaseLayout title={`Writing · ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
  <header class="page-content writing-page-heading">
    <p class="eyebrow">Notes from the garage</p>
    <h1>Writing</h1>
    <p class="page-dek">
      Field notes and longer thoughts, when there are some to share.
    </p>
  </header>
  <WritingLog posts={posts} />
</BaseLayout>

<style>
  .writing-page-heading {
    width: 100%;
    padding-bottom: 0;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--mute);
    font:
      500 11px/1.4 var(--mono),
      ui-monospace,
      monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
