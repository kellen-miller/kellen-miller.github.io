---
import type { EnrichedProject } from '../../data/github.ts';
import { projectDrawing } from './drawing.ts';

interface Props {
  project: EnrichedProject;
  hotId: string | null;
  maxCommits: number;
}

const { project, hotId, maxCommits } = Astro.props;
const isHot = hotId === project.id;
const meter = maxCommits > 0 ? (project.commits / maxCommits) * 100 : 0;
const drawing = projectDrawing(project.id, project.id.replaceAll('-', '_'));
---

<a
  class:list={['project-card', { hot: isHot }]}
  id={`project-${project.id}`}
  href={project.url}
  data-id={project.id}
  data-call={project.id}
  data-project-focus
  data-project-id={project.id}
  data-project-number={project.number}
  data-project-name={project.repo}
  data-project-object={project.object}
  data-project-spec={project.spec}
  data-project-lang={project.lang}
  data-project-commits={project.commits}
>
  <div class="draw">
    <div class="drawing" set:html={drawing} />
    <span class="plate" aria-hidden="true">
      {project.number}
    </span>
    <span class="object">{project.object}</span>
    <span class="figure">
      Fig. {project.number} — {project.spec}
    </span>
    <span class="ruler" aria-hidden="true"></span>
    <span class="registration bl" aria-hidden="true"></span>
    <span class="registration br" aria-hidden="true"></span>
  </div>
  <div class="caption">
    <h3>{project.repo}</h3>
    <p>{project.description}</p>
    <div class="foot">
      <span>{project.lang}</span>
      <i
        class="commit-meter"
        aria-label={`${project.commits} commits in the last year`}
      >
        <span style={`width: ${meter}%`}></span>
      </i>
      <span>{project.commits} commits</span>
    </div>
  </div>
</a>

<style>
  .project-card {
    position: relative;
    display: grid;
    min-width: 0;
    grid-template-rows: auto 1fr;
    background: var(--bg);
    color: inherit;
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .project-card.on {
    background: var(--card-on);
  }

  .project-card h3 {
    margin: 0;
    color: var(--ink);
    font:
      600 17px/1.35 var(--mono),
      ui-monospace,
      monospace;
    letter-spacing: -0.01em;
  }

  .project-card.on h3,
  .project-card:hover h3,
  .project-card:focus-visible h3 {
    color: var(--acc-ink);
  }

  .draw {
    position: relative;
    min-width: 0;
    overflow: hidden;
  }

  .drawing :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    background: radial-gradient(
      ellipse at 50% 60%,
      var(--card-glow),
      var(--bg) 70%
    );
  }

  .project-card.on .drawing :global(svg) {
    background: radial-gradient(
      ellipse at 50% 60%,
      var(--card-on),
      var(--bg) 70%
    );
  }

  .plate {
    position: absolute;
    top: 16px;
    left: 16px;
    display: grid;
    min-width: 46px;
    height: 32px;
    padding: 0 8px;
    place-items: center;
    border-radius: 6px;
    background: var(--ink);
    color: var(--bg);
    font:
      800 17px/1 var(--mono),
      ui-monospace,
      monospace;
    letter-spacing: -0.02em;
  }

  .hot .plate {
    background: var(--acc);
    color: var(--on-acc);
  }

  .object {
    position: absolute;
    top: 22px;
    right: 18px;
    max-width: calc(100% - 100px);
    overflow: hidden;
    color: var(--mute);
    font:
      500 11px/1.4 var(--mono),
      ui-monospace,
      monospace;
    letter-spacing: 0.08em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .figure {
    position: absolute;
    bottom: 9px;
    left: 12px;
    max-width: calc(100% - 126px);
    padding: 1px 5px;
    background: var(--bg);
    color: var(--mute);
    font:
      10px/1.4 var(--mono),
      ui-monospace,
      monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ruler {
    position: absolute;
    right: 16px;
    bottom: 14px;
    width: 84px;
    height: 8px;
    border-bottom: 1px solid var(--faint);
    background:
      repeating-linear-gradient(90deg, var(--faint) 0 1px, transparent 1px 7px)
        bottom / 100% 4px no-repeat,
      repeating-linear-gradient(90deg, var(--faint) 0 1px, transparent 1px 42px)
        bottom / 100% 8px no-repeat;
  }

  .registration {
    position: absolute;
    top: 50%;
    width: 9px;
    height: 9px;
    opacity: 0.6;
  }

  .registration::before,
  .registration::after {
    position: absolute;
    background: var(--faint);
    content: '';
  }

  .registration::before {
    top: 0;
    left: 4px;
    width: 1px;
    height: 9px;
  }

  .registration::after {
    top: 4px;
    left: 0;
    width: 9px;
    height: 1px;
  }

  .bl {
    left: 10px;
  }

  .br {
    right: 10px;
  }

  .caption {
    display: grid;
    gap: 6px;
    align-content: start;
    padding: 14px 20px 20px;
    border-top: 1px dashed var(--line);
  }

  .caption p {
    margin: 0;
    color: var(--mute);
    font-size: 15px;
    line-height: 1.5;
  }

  .foot {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    margin-top: 6px;
    color: var(--mute);
    font:
      11px/1.4 var(--mono),
      ui-monospace,
      monospace;
    letter-spacing: 0.04em;
  }

  .foot i {
    display: block;
    height: 6px;
    overflow: hidden;
    background: transparent;
  }

  .foot i span {
    display: block;
    height: 100%;
    background: var(--ink);
  }

  .project-card.hot .foot i span {
    background: var(--acc);
  }

  .project-card:focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: -2px;
  }
</style>
