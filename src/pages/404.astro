---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found · Kellen Miller"
  description="This page could not be found."
>
  <meta slot="head" name="robots" content="noindex" />
  <section class="page-content">
    <p class="eyebrow">404 · Wrong turn</p>
    <h1>Nothing in this bay.</h1>
    <p class="page-dek">That address doesn’t lead to a page here.</p>
    <p>
      <a href="/">Return to the garage →</a>
    </p>
  </section>
</BaseLayout>

<style>
  .eyebrow {
    margin: 0 0 14px;
    color: var(--mute);
    font:
      500 11px/1.4 var(--mono),
      ui-monospace,
      monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
